<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- To read a recipe page whose address was shared here or typed in, and, once the reader
         has signed in to one, to sync with their own Nextcloud. For nothing else. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To ask the clock app for a timer in cook mode, as Android requires of any app that does. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <queries>
        <!-- Home, whose dark mode switch this app follows when Home is installed, and whose Nextcloud
             account it can use (sync/HomeAccount.kt). -->
        <package android:name="com.wanderwildwood.iori" />
        <!-- Notes, which takes the shopping list. -->
        <package android:name="com.wanderwildwood.oboegaki" />
        <!-- Cabinet, which draws the open and save screens for the e-ink panel. -->
        <package android:name="com.wanderwildwood.tana" />
        <!-- A clock that starts a timer when asked. -->
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <!-- The page a recipe came from, in the browser. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- Lets the text-selection menu see other apps' text actions, such as Define from the
             Dictionary, beside Copy. Without it Android 11+ hides them from this app. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <!-- https for everything except a Nextcloud at home or on a VPN (a private or Tailscale address
         or a local name); the config allows plain http and sync/Nextcloud.kt enforces that rule
         (xml/network_security_config). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/no_backup"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher_mudita"
        android:roundIcon="@drawable/ic_launcher_mudita"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.App">

        <!-- Starts dark mode before the first screen is drawn. Holds no data. -->
        <provider
            android:name="com.wanderwildwood.kondate.ui.DarkModeInit"
            android:authorities="${applicationId}.darkmodeinit"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- A recipe page shared from the browser (its address, read and kept), or the recipe's selected
                 text shared from it (a draft, made on the phone). -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- No filter for JSON files: a recipe file is plain JSON, with no type or name ending of its
                 own, and a filter for it would offer Recipes for every JSON file on the phone. A file
                 of recipes comes in through Settings, which picks it. -->
        </activity>

    </application>

</manifest>
